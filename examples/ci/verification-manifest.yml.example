# Optional template: replace reviewed action SHAs and configure the two trusted
# repository variables before copying into .github/workflows. No project scripts.
name: Repogi verification artifact
on:
  pull_request:
  workflow_dispatch:
    inputs:
      base:
        description: Existing full base commit SHA
        required: true
      head:
        description: Existing full head commit SHA
        required: true
permissions:
  contents: read
jobs:
  manifest:
    runs-on: ubuntu-latest
    env:
      BASE_REV: ${{ github.event.pull_request.base.sha || inputs.base }}
      HEAD_REV: ${{ github.event.pull_request.head.sha || inputs.head }}
      ATLAS_URL: ${{ vars.ATLAS_LINUX_AMD64_URL }}
      ATLAS_SHA256: ${{ vars.ATLAS_LINUX_AMD64_SHA256 }}
    steps:
      - uses: actions/checkout@REPLACE_WITH_REVIEWED_FULL_COMMIT_SHA
        with:
          ref: ${{ github.event.pull_request.head.sha || inputs.head }}
          fetch-depth: 0
          persist-credentials: false
      - name: Select trusted Repogi executable and compare existing commits
        shell: bash
        run: |
          set -euo pipefail
          [[ "$BASE_REV" =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]]
          [[ "$HEAD_REV" =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]]
          [[ "$ATLAS_SHA256" =~ ^[0-9a-f]{64}$ ]]
          git --no-optional-locks cat-file -e "$BASE_REV^{commit}"
          git --no-optional-locks cat-file -e "$HEAD_REV^{commit}"
          task_dir=$(mktemp -d "$RUNNER_TEMP/atlas-artifact.XXXXXX")
          curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
            "$ATLAS_URL" --output "$task_dir/repogi"
          printf '%s  %s\n' "$ATLAS_SHA256" "$task_dir/repogi" | sha256sum --check --status
          chmod 700 "$task_dir/repogi"
          "$task_dir/repogi" impact "$GITHUB_WORKSPACE" \
            --base "$BASE_REV" --head "$HEAD_REV" --manifest --format json \
            --depth 2 --max-results 1000 --max-declarations 100 --max-bytes 8000000 \
            > "$task_dir/manifest.pending"
          "$task_dir/repogi" manifest-verify "$task_dir/manifest.pending" \
            > "$task_dir/atlas-verification-integrity.json"
          mv "$task_dir/manifest.pending" "$task_dir/atlas-verification-manifest.json"
          printf 'ATLAS_ARTIFACT_DIR=%s\n' "$task_dir" >> "$GITHUB_ENV"
      - uses: actions/upload-artifact@REPLACE_WITH_REVIEWED_FULL_COMMIT_SHA
        with:
          name: atlas-verification-manifest
          path: |
            ${{ env.ATLAS_ARTIFACT_DIR }}/atlas-verification-manifest.json
            ${{ env.ATLAS_ARTIFACT_DIR }}/atlas-verification-integrity.json
          if-no-files-found: error
          retention-days: 7
