# INCOMPLETE / UNAUTHORIZED. Keep outside .github/workflows.
# Verified action pins do not resolve executable, source or publication approval.
name: Atlas narrowly scoped hosted pilot candidate
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  manifest:
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    env:
      ATLAS_HOSTED_PILOT_AUTHORIZED: 'false'
      ATLAS_TRUSTED_REPOSITORY: REPLACE_WITH_REVIEWED_ATLAS_REPOSITORY
      ATLAS_TRUSTED_REVISION: REPLACE_WITH_REVIEWED_FULL_ATLAS_COMMIT
      ATLAS_APPROVED_PLAN_JSON: ${{ vars.ATLAS_APPROVED_PLAN_JSON }}
      ATLAS_APPROVED_CONFIG_SHA256: ${{ vars.ATLAS_APPROVED_CONFIG_SHA256 }}
    steps:
      - name: Incomplete candidate latch — requires a new reviewed approval package
        shell: bash
        run: |
          set -euo pipefail
          test "$ATLAS_HOSTED_PILOT_AUTHORIZED" = true
      - name: Checkout separately trusted Atlas tools, never the contribution's tools
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: ${{ env.ATLAS_TRUSTED_REPOSITORY }}
          ref: ${{ env.ATLAS_TRUSTED_REVISION }}
          path: trusted-atlas
          persist-credentials: false
          fetch-depth: 1
          lfs: false
          submodules: false
          allow-unsafe-pr-checkout: false
      - name: Validate independently approved plan before reading the target
        id: policy
        shell: bash
        run: |
          set -euo pipefail
          umask 077
          python3 -I - <<'PY'
          import json, os, pathlib, subprocess, sys
          tools = pathlib.Path(os.environ['GITHUB_WORKSPACE']) / 'trusted-atlas'
          sys.path.insert(0, str(tools / 'examples/ci'))
          import deployment_preflight as gate
          plan = json.loads(os.environ['ATLAS_APPROVED_PLAN_JSON'])
          expected = os.environ['ATLAS_APPROVED_CONFIG_SHA256']
          failures = gate.blockers(plan, expected)
          if failures: raise SystemExit('; '.join(failures))
          cfg = plan['configuration']
          event = json.loads(pathlib.Path(os.environ['GITHUB_EVENT_PATH']).read_text())
          if os.environ['GITHUB_EVENT_NAME'] != 'workflow_dispatch': raise SystemExit('manual event required')
          if event.get('repository', {}).get('private') is not True or event.get('repository', {}).get('fork') is not False:
              raise SystemExit('private non-fork repository metadata required')
          if cfg['target']['repository'] != os.environ['GITHUB_REPOSITORY']: raise SystemExit('cross-repository publication refused')
          if cfg['workflow']['source_revision'] != os.environ['GITHUB_WORKFLOW_SHA']: raise SystemExit('workflow source revision mismatch')
          actual = subprocess.check_output(['git', '--no-optional-locks', '-C', str(tools), 'rev-parse', 'HEAD'], text=True).strip()
          if actual != cfg['verifier']['source_revision']: raise SystemExit('trusted tools revision mismatch')
          run_dir = pathlib.Path(os.environ['RUNNER_TEMP']) / 'atlas-approved-pilot'
          run_dir.mkdir(mode=0o700)
          (run_dir / 'plan.json').write_text(json.dumps(plan))
          with open(os.environ['GITHUB_OUTPUT'], 'a') as stream:
              stream.write('repository=' + cfg['target']['repository'] + '\n')
              stream.write('head=' + cfg['target']['head'] + '\n')
          PY
      - name: Checkout exact approved target head
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: ${{ steps.policy.outputs.repository }}
          ref: ${{ steps.policy.outputs.head }}
          path: analysed-source
          fetch-depth: 0
          persist-credentials: false
          lfs: false
          submodules: false
          allow-unsafe-pr-checkout: false
      - name: Select checksum-bound tools and independently validate complete output
        shell: bash
        run: |
          set -euo pipefail
          umask 077
          python3 -I - <<'PY'
          import hashlib, json, os, pathlib, subprocess, sys
          workspace = pathlib.Path(os.environ['GITHUB_WORKSPACE'])
          tools = workspace / 'trusted-atlas'
          sys.path.insert(0, str(tools / 'examples/ci'))
          import deployment_preflight as gate
          run_dir = pathlib.Path(os.environ['RUNNER_TEMP']) / 'atlas-approved-pilot'
          plan = json.loads((run_dir / 'plan.json').read_text())
          errors = gate.blockers(plan, os.environ['ATLAS_APPROVED_CONFIG_SHA256'])
          if errors: raise SystemExit('; '.join(errors))
          cfg = plan['configuration']
          for name, spec in [('code-intel', cfg['executable']), ('blake3-stdin', cfg['verifier'])]:
              url = spec['url'] if name == 'code-intel' else spec['hash_provider_url']
              checksum = spec['sha256'] if name == 'code-intel' else spec['hash_provider_sha256']
              destination = run_dir / name
              subprocess.run(['curl', '--fail', '--silent', '--show-error', '--location', '--proto', '=https',
                              '--proto-redir', '=https', url, '--output', str(destination)], check=True)
              if hashlib.sha256(destination.read_bytes()).hexdigest() != checksum:
                  raise SystemExit('trusted executable checksum mismatch')
              destination.chmod(0o700)
          gate.generate(plan, os.environ['ATLAS_APPROVED_CONFIG_SHA256'], run_dir / 'code-intel',
                        workspace / 'analysed-source', run_dir / 'verified', run_dir / 'blake3-stdin')
          PY
      - name: Upload only the finalized manifest and integrity record
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: atlas-verification-manifest
          path: |
            ${{ runner.temp }}/atlas-approved-pilot/verified/atlas-verification-manifest.json
            ${{ runner.temp }}/atlas-approved-pilot/verified/atlas-verification-integrity.json
          if-no-files-found: error
          retention-days: 7
          overwrite: false
          include-hidden-files: false
          archive: true
